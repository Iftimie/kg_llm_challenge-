{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "deepseek": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepSeek",
      "options": {
        "baseURL": "https://api.deepseek.com/v1",
        "apiKey": "{env:DEEPSEEK_APIKEY}"
      },
      "models": {
        "deepseek-flash": {
          "name": "DeepSeek V4.1 Flash",
          "tool_call": true,
          "limit": { "context": 1048576, "output": 16384 }
        }
      }
    },
    "openrouter": {
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}"
      },
      "models": {
        "meta/muse-spark-1.3-contributor": {
          "name": "Muse Spark (OpenRouter)",
          "tool_call": true,
          "limit": { "context": 131072, "output": 16384 }
        }
      }
    }
  },
  "mcp": {
    "sales-kg": {
      "type": "local",
      "command": [".venv\\Scripts\\python.exe", "-m", "app.mcp.server"],
      "enabled": true
    }
  },
  "plugin": [
    "file:///C:/Users/Alexandru/Desktop/SabbaticalProjects/codex_or_llm_agent/kg_challenge_step_by_step/.opencode/plugins/trace-log.ts"
  ],
  "default_agent": "orchestrator",
  "small_model": "deepseek/deepseek-flash",
  "model": "openrouter/meta/muse-spark-1.3-contributor"
}
