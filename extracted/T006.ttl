@prefix crm: <https://example.org/sales-kg/> .
@prefix res: <https://example.org/sales-kg/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

res:Deal_D006
    crm:hasNeed res:PainPoint_D006_shipment_exceptions ;
    crm:hasDecisionCriterion res:DecisionCriterion_D006_business_case ;
    crm:hasAction res:SalesAction_D006_workshop .

res:PainPoint_D006_shipment_exceptions
    a crm:PainPoint ;
    crm:name "Shipment exception handling" ;
    crm:supportedBy res:Evidence_T006_001 .

res:DecisionCriterion_D006_business_case
    a crm:DecisionCriterion ;
    crm:name "Clear business case around one process" ;
    crm:supportedBy res:Evidence_T006_002 .

res:SalesAction_D006_workshop
    a crm:SalesAction ;
    crm:name "Focus next workshop on shipment exceptions and quantify manual effort" ;
    crm:supportedBy res:Evidence_T006_003 .

res:Evidence_T006_001
    a crm:Evidence ;
    crm:sourceTranscript res:Transcript_T006 ;
    crm:speakerName "Arthur Peeters" ;
    crm:evidenceText "Shipment exception handling is probably the best candidate. The team spends hours coordinating exceptions by email." ;
    crm:evidenceTimestamp "2026-09-01T00:00:00"^^xsd:dateTime .

res:Evidence_T006_002
    a crm:Evidence ;
    crm:sourceTranscript res:Transcript_T006 ;
    crm:speakerName "Louise Dubois" ;
    crm:evidenceText "Before we discuss software, I want a clear business case around one process." ;
    crm:evidenceTimestamp "2026-09-01T00:00:00"^^xsd:dateTime .

res:Evidence_T006_003
    a crm:Evidence ;
    crm:sourceTranscript res:Transcript_T006 ;
    crm:speakerName "Chris" ;
    crm:evidenceText "We'll focus the next workshop on shipment exceptions and quantify the current manual effort." ;
    crm:evidenceTimestamp "2026-09-01T00:00:00"^^xsd:dateTime .
