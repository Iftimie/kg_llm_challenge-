@prefix crm: <https://example.org/sales-kg/> .
@prefix res: <https://example.org/sales-kg/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

res:Deal_D004
    crm:hasBlocker res:Blocker_D004_budget_freeze ;
    crm:hasBlocker res:Blocker_D004_priority_issue .

res:Blocker_D004_budget_freeze
    a crm:Blocker ;
    crm:name "Budget freeze" ;
    crm:supportedBy res:Evidence_T004_001 .

res:Blocker_D004_priority_issue
    a crm:Blocker ;
    crm:name "Low priority initiative" ;
    crm:supportedBy res:Evidence_T004_002 .

res:Evidence_T004_001
    a crm:Evidence ;
    crm:sourceTranscript res:Transcript_T004 ;
    crm:speakerName "Camille Martin" ;
    crm:evidenceText "Finance froze most discretionary spending for the rest of the year." .

res:Evidence_T004_002
    a crm:Evidence ;
    crm:sourceTranscript res:Transcript_T004 ;
    crm:speakerName "Camille Martin" ;
    crm:evidenceText "this isn't considered critical compared with our other initiatives." .
