@prefix crm: <https://example.org/sales-kg/> .
@prefix res: <https://example.org/sales-kg/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

res:Deal_D007
    crm:hasNeed res:Need_T007_lineage_monitoring ;
    crm:hasDecisionCriterion res:DecisionCriterion_T007_pricing_incentive ;
    crm:hasBuyingSignal res:Signal_T007_multi_year_options ;
    crm:hasBuyingSignal res:Signal_T007_legal_review_ready .

res:Need_T007_lineage_monitoring
    a crm:CustomerNeed ;
    crm:name "Lineage and monitoring in implementation plan" ;
    crm:supportedBy res:Evidence_T007_001 .

res:DecisionCriterion_T007_pricing_incentive
    a crm:DecisionCriterion ;
    crm:name "Pricing incentive for three-year commitment" ;
    crm:supportedBy res:Evidence_T007_002 .

res:Signal_T007_multi_year_options
    a crm:BuyingSignal ;
    crm:name "Willing to review multi-year options" ;
    crm:supportedBy res:Evidence_T007_003 .

res:Signal_T007_legal_review_ready
    a crm:BuyingSignal ;
    crm:name "Ready for legal review contingent on commercial terms" ;
    crm:supportedBy res:Evidence_T007_004 .

res:Evidence_T007_001
    a crm:Evidence ;
    crm:sourceTranscript res:Transcript_T007 ;
    crm:speakerName "Priya Shah" ;
    crm:evidenceText "We still want lineage and monitoring included in the implementation plan, but I don't see that as a blocker." .

res:Evidence_T007_002
    a crm:Evidence ;
    crm:sourceTranscript res:Transcript_T007 ;
    crm:speakerName "James Carter" ;
    crm:evidenceText "For three years, I need a meaningful incentive." .

res:Evidence_T007_003
    a crm:Evidence ;
    crm:sourceTranscript res:Transcript_T007 ;
    crm:speakerName "James Carter" ;
    crm:evidenceText "Show me both a two-year and a three-year option." .

res:Evidence_T007_004
    a crm:Evidence ;
    crm:sourceTranscript res:Transcript_T007 ;
    crm:speakerName "James Carter" ;
    crm:evidenceText "Yes." .
