@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix crm: <https://example.org/sales-kg/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Minimal closed-world checks for the RML output.
# Only required (minCount) constraints — optional fields like lossReason are unchecked.

crm:AccountShape a sh:NodeShape ;
    sh:targetClass crm:Account ;
    sh:property [ sh:path crm:identifier ; sh:minCount 1 ] ;
    sh:property [ sh:path crm:name ; sh:minCount 1 ] .

crm:ContactShape a sh:NodeShape ;
    sh:targetClass crm:CustomerContact ;
    sh:property [ sh:path crm:identifier ; sh:minCount 1 ] ;
    sh:property [ sh:path crm:name ; sh:minCount 1 ] ;
    sh:property [ sh:path crm:worksFor ; sh:minCount 1 ; sh:nodeKind sh:IRI ] .

crm:DealShape a sh:NodeShape ;
    sh:targetClass crm:Deal ;
    sh:property [ sh:path crm:identifier ; sh:minCount 1 ] ;
    sh:property [ sh:path crm:name ; sh:minCount 1 ] ;
    sh:property [ sh:path crm:dealStage ; sh:minCount 1 ] ;
    sh:property [ sh:path crm:dealValue ; sh:minCount 1 ; sh:datatype xsd:decimal ] ;
    sh:property [ sh:path crm:winProbability ; sh:minCount 1 ; sh:datatype xsd:decimal ] ;
    sh:property [ sh:path crm:expectedCloseDate ; sh:minCount 1 ; sh:datatype xsd:date ] ;
    sh:property [ sh:path crm:forAccount ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path crm:involvesProduct ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path crm:ownedBy ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path crm:hasOutcome ; sh:minCount 1 ; sh:nodeKind sh:IRI ] .

crm:InteractionShape a sh:NodeShape ;
    sh:targetClass crm:Interaction ;
    sh:property [ sh:path crm:identifier ; sh:minCount 1 ] ;
    sh:property [ sh:path crm:interactionDate ; sh:minCount 1 ; sh:datatype xsd:dateTime ] ;
    sh:property [ sh:path crm:aboutDeal ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path crm:hasParticipant ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path crm:hasTranscript ; sh:minCount 1 ; sh:nodeKind sh:IRI ] .

crm:TranscriptShape a sh:NodeShape ;
    sh:targetClass crm:Transcript ;
    sh:property [ sh:path crm:identifier ; sh:minCount 1 ] .

crm:ProductShape a sh:NodeShape ;
    sh:targetClass crm:Product ;
    sh:property [ sh:path crm:name ; sh:minCount 1 ] .

crm:SalesRepShape a sh:NodeShape ;
    sh:targetClass crm:SalesRep ;
    sh:property [ sh:path crm:identifier ; sh:minCount 1 ] .

crm:IndustryShape a sh:NodeShape ;
    sh:targetClass crm:Industry ;
    sh:property [ sh:path crm:name ; sh:minCount 1 ] .
