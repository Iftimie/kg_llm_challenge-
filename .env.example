# Copy to `.env` and fill in real values. `.env` is gitignored.
# `docker compose` reads this file automatically for variable substitution.

# --- LLM (DeepSeek, OpenAI-compatible) ---
DEEPSEEK_APIKEY=change-me
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# --- Auth ---
JWT_SECRET=
# Comma-separated emails granted admin rights (clear + ingest). Matching is
# case-insensitive; register/login with one of these emails to become admin.
ADMIN_EMAILS=

# --- GraphDB (auto-secured at boot with these passwords) ---
GRAPHDB_ADMIN_PASSWORD=
GRAPHDB_READER_PASSWORD=
# App read-only creds must match the reader password above.
GRAPHDB_USER=
GRAPHDB_PASSWORD=

# --- Rate limiting (per minute; 0 disables) ---
# RATE_LIMIT_CHAT_PER_MIN=10
# RATE_LIMIT_AUTH_PER_MIN=5
