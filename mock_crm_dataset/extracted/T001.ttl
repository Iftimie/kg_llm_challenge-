@prefix crm: <https://example.org/sales-kg/> .
@prefix res: <https://example.org/sales-kg/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

res:Deal_D001
    crm:hasBlocker res:Blocker_D001_pricing ;
    crm:hasBlocker res:Blocker_D001_security ;
    crm:hasBuyingSignal res:Signal_D001_expansion_intent ;
    crm:hasBuyingSignal res:Signal_D001_meeting_commitment .

res:Blocker_D001_pricing
    a crm:Blocker ;
    crm:name "Pricing for three factories" ;
    crm:supportedBy res:Evidence_T001_001 .

res:Blocker_D001_security
    a crm:Blocker ;
    crm:name "SSO and data residency confirmation" ;
    crm:supportedBy res:Evidence_T001_002 .

res:Signal_D001_expansion_intent
    a crm:BuyingSignal ;
    crm:name "Three-factory deployment plan" ;
    crm:supportedBy res:Evidence_T001_003 .

res:Signal_D001_meeting_commitment
    a crm:BuyingSignal ;
    crm:name "Commitment to review next Tuesday" ;
    crm:supportedBy res:Evidence_T001_004 .

res:Evidence_T001_001
    a crm:Evidence ;
    crm:sourceTranscript res:Transcript_T001 ;
    crm:speakerName "Anna Keller" ;
    crm:evidenceText "procurement expects a better price than what is currently in the proposal" ;
    crm:evidenceTimestamp "2026-09-10T00:00:00"^^xsd:dateTime .

res:Evidence_T001_002
    a crm:Evidence ;
    crm:sourceTranscript res:Transcript_T001 ;
    crm:speakerName "Markus Vogel" ;
    crm:evidenceText "I also still need confirmation regarding SSO and data residency" ;
    crm:evidenceTimestamp "2026-09-10T00:00:00"^^xsd:dateTime .

res:Evidence_T001_003
    a crm:Evidence ;
    crm:sourceTranscript res:Transcript_T001 ;
    crm:speakerName "Anna Keller" ;
    crm:evidenceText "expanding to all three this year" ;
    crm:evidenceTimestamp "2026-09-10T00:00:00"^^xsd:dateTime .

res:Evidence_T001_004
    a crm:Evidence ;
    crm:sourceTranscript res:Transcript_T001 ;
    crm:speakerName "Anna Keller" ;
    crm:evidenceText "Yes, that works" ;
    crm:evidenceTimestamp "2026-09-10T00:00:00"^^xsd:dateTime .
