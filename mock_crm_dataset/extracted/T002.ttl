@prefix crm: <https://example.org/sales-kg/> .
@prefix res: <https://example.org/sales-kg/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

res:Deal_D002
    crm:hasNeed res:PainPoint_T002_managers_trust ;
    crm:hasNeed res:BusinessGoal_T002_forecast_accuracy ;
    crm:hasBlocker res:Blocker_T002_custom_fields ;
    crm:hasBuyingSignal res:BuyingSignal_T002_metrics_agreement ;
    crm:hasExpansionOpportunity res:ExpansionOpportunity_T002_org_rollout ;
    crm:hasAction res:SalesAction_T002_define_metrics .

res:PainPoint_T002_managers_trust
    a crm:PainPoint ;
    crm:name "Managers don't trust current forecast" ;
    crm:supportedBy res:Evidence_T002_001 .

res:BusinessGoal_T002_forecast_accuracy
    a crm:BusinessGoal ;
    crm:name "Forecast accuracy" ;
    crm:supportedBy res:Evidence_T002_002 .

res:Blocker_T002_custom_fields
    a crm:Blocker ;
    crm:name "Custom opportunity fields mapping requirement" ;
    crm:supportedBy res:Evidence_T002_003 .

res:BuyingSignal_T002_metrics_agreement
    a crm:BuyingSignal ;
    crm:name "Agreement to define success metrics" ;
    crm:supportedBy res:Evidence_T002_004 .

res:ExpansionOpportunity_T002_org_rollout
    a crm:ScopeExpansion ;
    crm:name "Rollout to entire sales organization" ;
    crm:supportedBy res:Evidence_T002_005 ;
    crm:expansionInvolvesProduct res:Product_Analytics%20Module .

res:SalesAction_T002_define_metrics
    a crm:SalesAction ;
    crm:name "Define success metrics before pilot" ;
    crm:supportedBy res:Evidence_T002_006 .

res:Evidence_T002_001
    a crm:Evidence ;
    crm:sourceTranscript res:Transcript_T002 ;
    crm:speakerName "Eva de Vries" ;
    crm:evidenceText "Our managers don't trust the current forecast." ;
    crm:evidenceTimestamp "2026-08-21T00:00:00"^^xsd:dateTime .

res:Evidence_T002_002
    a crm:Evidence ;
    crm:sourceTranscript res:Transcript_T002 ;
    crm:speakerName "Eva de Vries" ;
    crm:evidenceText "Forecast accuracy is the main thing." ;
    crm:evidenceTimestamp "2026-08-21T00:00:00"^^xsd:dateTime .

res:Evidence_T002_003
    a crm:Evidence ;
    crm:sourceTranscript res:Transcript_T002 ;
    crm:speakerName "Tom Smit" ;
    crm:evidenceText "We also have a lot of custom opportunity fields in the CRM. If your connector ignores those, the dashboard won't be useful." ;
    crm:evidenceTimestamp "2026-08-21T00:00:00"^^xsd:dateTime .

res:Evidence_T002_004
    a crm:Evidence ;
    crm:sourceTranscript res:Transcript_T002 ;
    crm:speakerName "Eva de Vries" ;
    crm:evidenceText "Yes. Forecast accuracy, pipeline coverage, conversion by stage, and probably manager adoption." ;
    crm:evidenceTimestamp "2026-08-21T00:00:00"^^xsd:dateTime .

res:Evidence_T002_005
    a crm:Evidence ;
    crm:sourceTranscript res:Transcript_T002 ;
    crm:speakerName "Eva de Vries" ;
    crm:evidenceText "Then I can make the case for rolling it out to the entire sales organization." ;
    crm:evidenceTimestamp "2026-08-21T00:00:00"^^xsd:dateTime .

res:Evidence_T002_006
    a crm:Evidence ;
    crm:sourceTranscript res:Transcript_T002 ;
    crm:speakerName "Michael (Sales)" ;
    crm:evidenceText "Would you be comfortable defining three or four success metrics before the pilot starts?" ;
    crm:evidenceTimestamp "2026-08-21T00:00:00"^^xsd:dateTime .
