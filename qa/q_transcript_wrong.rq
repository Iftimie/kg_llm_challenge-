PREFIX crm: <https://example.org/sales-kg/>
PREFIX res: <https://example.org/sales-kg/resource/>

SELECT ?interaction ?transcript ?transcriptText
WHERE {
  ?interaction crm:aboutDeal res:Deal_D001 ;
               crm:hasTranscript ?transcript .
  OPTIONAL {
    ?transcript crm:transcriptText ?transcriptText .
  }
}
