@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix crm: <https://example.org/sales-kg/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Base IRI for instances: https://example.org/sales-kg/resource/
# Ontology terms: https://example.org/sales-kg/ + local name (matches sales_kg_ontology_v1.ttl)

<#AccountMap> a rr:TriplesMap ;
    rml:logicalSource [ rml:source "mock_crm_dataset/accounts.csv" ; rml:referenceFormulation ql:CSV ] ;
    rr:subjectMap [ rr:template "https://example.org/sales-kg/resource/Account_{account_id}" ; rr:class crm:Account ] ;
    rr:predicateObjectMap [ rr:predicate crm:identifier ; rr:objectMap [ rml:reference "account_id" ] ] ;
    rr:predicateObjectMap [ rr:predicate crm:name ; rr:objectMap [ rml:reference "account_name" ] ] .

<#IndustryMap> a rr:TriplesMap ;
    rml:logicalSource [ rml:source "mock_crm_dataset/accounts.csv" ; rml:referenceFormulation ql:CSV ] ;
    rr:subjectMap [ rr:template "https://example.org/sales-kg/resource/Industry_{industry}" ; rr:class crm:Industry ] ;
    rr:predicateObjectMap [ rr:predicate crm:name ; rr:objectMap [ rml:reference "industry" ] ] .

<#ContactMap> a rr:TriplesMap ;
    rml:logicalSource [ rml:source "mock_crm_dataset/contacts.csv" ; rml:referenceFormulation ql:CSV ] ;
    rr:subjectMap [ rr:template "https://example.org/sales-kg/resource/Contact_{contact_id}" ; rr:class crm:CustomerContact ] ;
    rr:predicateObjectMap [ rr:predicate crm:identifier ; rr:objectMap [ rml:reference "contact_id" ] ] ;
    rr:predicateObjectMap [ rr:predicate crm:name ; rr:objectMap [ rr:template "{first_name} {last_name}" ; rr:termType rr:Literal ] ] ;
    rr:predicateObjectMap [ rr:predicate crm:worksFor ; rr:objectMap [ rr:parentTriplesMap <#AccountMap> ; rr:joinCondition [ rr:child "account_id" ; rr:parent "account_id" ] ] ] .

<#ProductMap> a rr:TriplesMap ;
    rml:logicalSource [ rml:source "mock_crm_dataset/deals.csv" ; rml:referenceFormulation ql:CSV ] ;
    rr:subjectMap [ rr:template "https://example.org/sales-kg/resource/Product_{product}" ; rr:class crm:Product ] ;
    rr:predicateObjectMap [ rr:predicate crm:name ; rr:objectMap [ rml:reference "product" ] ] .

<#SalesRepMap> a rr:TriplesMap ;
    rml:logicalSource [ rml:source "mock_crm_dataset/deals.csv" ; rml:referenceFormulation ql:CSV ] ;
    rr:subjectMap [ rr:template "https://example.org/sales-kg/resource/SalesRep_{owner_id}" ; rr:class crm:SalesRep ] ;
    rr:predicateObjectMap [ rr:predicate crm:identifier ; rr:objectMap [ rml:reference "owner_id" ] ] .

<#DealMap> a rr:TriplesMap ;
    rml:logicalSource [ rml:source "mock_crm_dataset/deals.csv" ; rml:referenceFormulation ql:CSV ] ;
    rr:subjectMap [ rr:template "https://example.org/sales-kg/resource/Deal_{deal_id}" ; rr:class crm:Deal ] ;
    rr:predicateObjectMap [ rr:predicate crm:identifier ; rr:objectMap [ rml:reference "deal_id" ] ] ;
    rr:predicateObjectMap [ rr:predicate crm:name ; rr:objectMap [ rml:reference "deal_name" ] ] ;
    rr:predicateObjectMap [ rr:predicate crm:dealStage ; rr:objectMap [ rml:reference "deal_stage" ] ] ;
    rr:predicateObjectMap [ rr:predicate crm:dealValue ; rr:objectMap [ rml:reference "deal_value_eur" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate crm:winProbability ; rr:objectMap [ rml:reference "win_probability" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate crm:expectedCloseDate ; rr:objectMap [ rml:reference "expected_close_date" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate crm:lossReason ; rr:objectMap [ rml:reference "loss_reason" ] ] ;
    rr:predicateObjectMap [ rr:predicate crm:forAccount ; rr:objectMap [ rr:parentTriplesMap <#AccountMap> ; rr:joinCondition [ rr:child "account_id" ; rr:parent "account_id" ] ] ] ;
    rr:predicateObjectMap [ rr:predicate crm:involvesProduct ; rr:objectMap [ rr:template "https://example.org/sales-kg/resource/Product_{product}" ; rr:termType rr:IRI ] ] ;
    rr:predicateObjectMap [ rr:predicate crm:ownedBy ; rr:objectMap [ rr:template "https://example.org/sales-kg/resource/SalesRep_{owner_id}" ; rr:termType rr:IRI ] ] ;
    rr:predicateObjectMap [ rr:predicate crm:hasOutcome ; rr:objectMap [ rr:template "https://example.org/sales-kg/{status}" ; rr:termType rr:IRI ] ] .

<#InteractionMap> a rr:TriplesMap ;
    rml:logicalSource [ rml:source "mock_crm_dataset/activities.csv" ; rml:referenceFormulation ql:CSV ] ;
    rr:subjectMap [ rr:template "https://example.org/sales-kg/resource/Interaction_{activity_id}" ; rr:class crm:Interaction ] ;
    rr:predicateObjectMap [ rr:predicate crm:identifier ; rr:objectMap [ rml:reference "activity_id" ] ] ;
    rr:predicateObjectMap [ rr:predicate crm:interactionDate ; rr:objectMap [ rml:reference "activity_at" ; rr:datatype xsd:dateTime ] ] ;
    rr:predicateObjectMap [ rr:predicate crm:aboutDeal ; rr:objectMap [ rr:parentTriplesMap <#DealMap> ; rr:joinCondition [ rr:child "deal_id" ; rr:parent "deal_id" ] ] ] ;
    rr:predicateObjectMap [ rr:predicate crm:hasParticipant ; rr:objectMap [ rr:parentTriplesMap <#ContactMap> ; rr:joinCondition [ rr:child "contact_id" ; rr:parent "contact_id" ] ] ] ;
    rr:predicateObjectMap [ rr:predicate crm:hasTranscript ; rr:objectMap [ rr:template "https://example.org/sales-kg/resource/Transcript_{activity_id}" ; rr:termType rr:IRI ] ] .

<#TranscriptFromActivityMap> a rr:TriplesMap ;
    rml:logicalSource [ rml:source "mock_crm_dataset/activities.csv" ; rml:referenceFormulation ql:CSV ] ;
    rr:subjectMap [ rr:template "https://example.org/sales-kg/resource/Transcript_{activity_id}" ; rr:class crm:Transcript ] ;
    rr:predicateObjectMap [ rr:predicate crm:identifier ; rr:objectMap [ rr:template "{activity_id}_transcript" ; rr:termType rr:Literal ] ] ;
    rr:predicateObjectMap [ rr:predicate crm:transcriptText ; rr:objectMap [ rml:reference "transcript_text" ] ] .

<#TranscriptFromFileMap> a rr:TriplesMap ;
    rml:logicalSource [ rml:source "mock_crm_dataset/transcripts.csv" ; rml:referenceFormulation ql:CSV ] ;
    rr:subjectMap [ rr:template "https://example.org/sales-kg/resource/Transcript_{transcript_id}" ; rr:class crm:Transcript ] ;
    rr:predicateObjectMap [ rr:predicate crm:identifier ; rr:objectMap [ rml:reference "transcript_id" ] ] ;
    rr:predicateObjectMap [ rr:predicate crm:transcriptText ; rr:objectMap [ rml:reference "transcript" ] ] ;
    rr:predicateObjectMap [ rr:predicate crm:aboutDeal ; rr:objectMap [ rr:parentTriplesMap <#DealMap> ; rr:joinCondition [ rr:child "deal_id" ; rr:parent "deal_id" ] ] ] .
